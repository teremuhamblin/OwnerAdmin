; === Directories ===
[HKEY_CLASSES_ROOT\Directory\shell\RestoreTrustedInstallerHacker]
@="Restore TrustedInstaller (Hacker Mode)"
"NoWorkingDirectory"=""

[HKEY_CLASSES_ROOT\Directory\shell\RestoreTrustedInstallerHacker\command]
@="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File \"C:\\Tools\\OwnershipTool.ps1\" -Action RestoreTrustedInstaller -Path \"%1\" -HackerMode 1"
